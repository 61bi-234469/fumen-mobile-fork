+use cold_clear::evaluation::Standard;
+use cold_clear::BotState;
+use enumset::EnumSet;
+use js_sys::Date;
+use libtetris::{Board, Move, Piece, RotationState};
+use wasm_bindgen::prelude::*;
+
+#[wasm_bindgen]
+pub struct CCMove {
+    pub hold: bool,
+    pub piece: u8,
+    pub rotation: u8,
+    pub x: i8,
+    pub y: i8,
+    pub score: f64,
+    pub b2b: bool,
+    pub combo: u32,
+}
+
+#[wasm_bindgen]
+pub struct ColdClearBot {
+    bot_state: BotState<Standard>,
+    evaluator: Standard,
+}
+
+fn piece_from_u8(piece: u8) -> Option<Piece> {
+    match piece {
+        0 => Some(Piece::I),
+        1 => Some(Piece::O),
+        2 => Some(Piece::T),
+        3 => Some(Piece::L),
+        4 => Some(Piece::J),
+        5 => Some(Piece::S),
+        6 => Some(Piece::Z),
+        _ => None,
+    }
+}
+
+fn piece_to_u8(piece: Piece) -> u8 {
+    match piece {
+        Piece::I => 0,
+        Piece::O => 1,
+        Piece::T => 2,
+        Piece::L => 3,
+        Piece::J => 4,
+        Piece::S => 5,
+        Piece::Z => 6,
+    }
+}
+
+fn rotation_to_u8(rotation: RotationState) -> u8 {
+    match rotation {
+        RotationState::North => 0,
+        RotationState::South => 1,
+        RotationState::East => 2,
+        RotationState::West => 3,
+    }
+}
+
+fn convert_move(mv: Move, score: f64, b2b: bool, combo: u32) -> CCMove {
+    let loc = mv.expected_location;
+    CCMove {
+        hold: mv.hold,
+        piece: piece_to_u8(loc.kind.0),
+        rotation: rotation_to_u8(loc.kind.1),
+        x: loc.x as i8,
+        y: loc.y as i8,
+        score,
+        b2b,
+        combo,
+    }
+}
+
+fn decode_field(field: &[u8]) -> [[bool; 10]; 40] {
+    let mut decoded = [[false; 10]; 40];
+    for y in 0..40 {
+        for x in 0..10 {
+            let index = y * 10 + x;
+            decoded[y][x] = field.get(index).copied().unwrap_or(0) != 0;
+        }
+    }
+    decoded
+}
+
+#[wasm_bindgen]
+impl ColdClearBot {
+    #[wasm_bindgen(constructor)]
+    pub fn new(
+        field: &[u8],
+        hold: u8,
+        b2b: bool,
+        combo: u32,
+        queue: &[u8],
+        hold_allowed: bool,
+        speculate: bool,
+    ) -> ColdClearBot {
+        let hold_piece = if hold == 255 { None } else { piece_from_u8(hold) };
+        let mut board = Board::new_with_state(
+            decode_field(field),
+            EnumSet::all(),
+            hold_piece,
+            b2b,
+            combo,
+        );
+        for &piece in queue {
+            if let Some(piece) = piece_from_u8(piece) {
+                board.add_next_piece(piece);
+            }
+        }
+
+        let mut options = cold_clear::Options::default();
+        options.use_hold = hold_allowed;
+        options.speculate = speculate;
+        options.threads = 1;
+
+        ColdClearBot {
+            bot_state: BotState::new(board, options),
+            evaluator: Standard::default(),
+        }
+    }
+
+    pub fn add_next_piece(&mut self, piece: u8) {
+        if let Some(piece) = piece_from_u8(piece) {
+            self.bot_state.add_next_piece(piece);
+        }
+    }
+
+    pub fn suggest_move_sync(&mut self, think_ms: u32) -> Option<CCMove> {
+        self.suggest_move_sync_with_incoming(think_ms, 0)
+    }
+
+    pub fn suggest_move_sync_with_incoming(
+        &mut self,
+        think_ms: u32,
+        incoming: u32,
+    ) -> Option<CCMove> {
+        self.run_think_loop(think_ms);
+        let (mv, _info, score, b2b, combo) = self
+            .bot_state
+            .suggest_move_with_score(&self.evaluator, None, incoming)?;
+        self.bot_state.advance_move(mv.expected_location);
+        Some(convert_move(mv, score, b2b, combo))
+    }
+
+    pub fn suggest_top_moves_sync(&mut self, think_ms: u32, count: u32) -> Vec<CCMove> {
+        self.suggest_top_moves_sync_with_incoming(think_ms, count, 0)
+    }
+
+    pub fn suggest_top_moves_sync_with_incoming(
+        &mut self,
+        think_ms: u32,
+        count: u32,
+        incoming: u32,
+    ) -> Vec<CCMove> {
+        self.run_think_loop(think_ms);
+
+        self.bot_state
+            .suggest_top_moves_with_score_and_incoming(count as usize, incoming)
+            .into_iter()
+            .map(|(mv, score, b2b, combo)| convert_move(mv, score, b2b, combo))
+            .collect()
+    }
+
+    /// Switches the evaluation weight table. `preset` 0 selects
+    /// `Standard::default()`, 1 selects `Standard::fast_config()`.
+    /// Returns false (no-op) for any other value.
+    pub fn set_weights_preset(&mut self, preset: u8) -> bool {
+        self.evaluator = match preset {
+            0 => Standard::default(),
+            1 => Standard::fast_config(),
+            _ => return false,
+        };
+        true
+    }
+}
+
+impl ColdClearBot {
+    fn run_think_loop(&mut self, think_ms: u32) {
+        let start = Date::now();
+        loop {
+            if Date::now() - start >= think_ms as f64 {
+                break;
+            }
+
+            match self.bot_state.think() {
+                Ok(thinker) => {
+                    let result = thinker.think(&self.evaluator);
+                    self.bot_state.finish_thinking(result);
+                }
+                Err(true) => continue,
+                Err(false) => break,
+            }
+        }
+    }
+}
+
+#[wasm_bindgen]
+pub fn init_panic_hook() {
+    console_error_panic_hook::set_once();
+}
